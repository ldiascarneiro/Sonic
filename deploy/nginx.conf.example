# Exemplo: incluir dentro do bloco http do Nginx. Ajustar domínio/certificados.
# As portas da aplicação devem continuar vinculadas a 127.0.0.1.
limit_req_zone $binary_remote_addr zone=sonic_requests:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=sonic_connections:10m;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name brincar.seudominio.com;
    return 308 https://brincar.seudominio.com$request_uri;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name brincar.seudominio.com;
    ssl_certificate /etc/letsencrypt/live/brincar.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brincar.seudominio.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 8k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 20s;
    access_log off;
    limit_req_status 429;
    limit_conn_status 429;

    location / {
        limit_req zone=sonic_requests burst=30 nodelay;
        limit_conn sonic_connections 20;
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host brincar.seudominio.com;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
